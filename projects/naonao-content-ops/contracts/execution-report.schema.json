{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naonao-content-ops/contracts/execution-report.schema.json",
  "title": "Execution Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "file_results"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^wo_[a-zA-Z0-9_-]{6,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileResult"
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "fileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_alias",
        "path",
        "operation",
        "status"
      ],
      "properties": {
        "root_alias": {
          "type": "string",
          "enum": [
            "openclaw",
            "naonao_project"
          ]
        },
        "path": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": [
            "ADD",
            "MODIFY",
            "MERGE",
            "DELETE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "skipped",
            "failed"
          ]
        },
        "diff_summary": {
          "type": "string"
        },
        "backup_path": {
          "type": "string"
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "status"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "exists",
                  "json_parse",
                  "json_schema",
                  "contains_text"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "skip"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "$ref": "#/$defs/issue"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "suggested_fix": {
          "type": "string"
        }
      }
    }
  }
}
