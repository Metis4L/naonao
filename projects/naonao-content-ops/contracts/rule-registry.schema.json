{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naonao-content-ops/contracts/rule-registry.schema.json",
  "title": "Rule Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "rules"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^v\\d+(\\.\\d+){0,2}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "douyin",
              "xiaohongshu",
              "wechat",
              "all"
            ]
          },
          "default": [
            "all"
          ]
        },
        "content_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hook",
              "body",
              "mechanism",
              "cta",
              "review",
              "all"
            ]
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "description",
        "status",
        "lifecycle_action",
        "scope",
        "priority",
        "instruction",
        "version",
        "owner",
        "created_at"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^rule_[a-zA-Z0-9_-]{4,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "active",
            "paused",
            "deprecated"
          ]
        },
        "lifecycle_action": {
          "type": "string",
          "enum": [
            "ADD",
            "MODIFY",
            "MERGE",
            "DEPRECATE",
            "DELETE",
            "REACTIVATE"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "good": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bad": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rule_[a-zA-Z0-9_-]{4,}$"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rule_[a-zA-Z0-9_-]{4,}$"
          }
        },
        "source_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ce_[a-zA-Z0-9_-]{6,}$"
          }
        },
        "acceptance_metric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric_name": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "window": {
              "type": "string"
            }
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "change_note": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
