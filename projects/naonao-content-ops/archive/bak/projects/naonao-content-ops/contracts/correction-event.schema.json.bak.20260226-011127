{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naonao-content-ops/correction-event.schema.json",
  "title": "CorrectionEvent",
  "type": "object",
  "required": ["event_id", "created_at", "source", "content_type", "diff_segments", "classifications", "root_cause_layer"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^ce_[a-zA-Z0-9_-]{6,}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["agent", "session"],
      "properties": {
        "agent": {"type": "string"},
        "session": {"type": "string"},
        "project": {"type": "string"}
      }
    },
    "content_type": {"type": "string", "enum": ["cat_food_analysis", "behavior", "newbie_cat", "comment_extension", "pet_hot_topic", "generic"]},
    "before_text": {"type": "string"},
    "after_text": {"type": "string"},
    "diff_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "operation", "before_text", "after_text"],
        "properties": {
          "segment_id": {"type": "string"},
          "operation": {"type": "string", "enum": ["add", "delete", "replace", "reorder"]},
          "before_text": {"type": "string"},
          "after_text": {"type": "string"},
          "span_note": {"type": "string"}
        }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "tag", "confidence"],
        "properties": {
          "category": {"type": "string", "enum": ["human_likeness", "tone_consistency", "logic_closure", "mechanism_explanation", "cta_coordination"]},
          "tag": {
            "type": "string",
            "enum": [
              "quote_overuse", "template_voice", "emotion_overdrive", "attitude_flip", "persona_shift",
              "missing_bridge", "premature_cta", "incomplete_reasoning", "topic_jump", "no_mechanism_explained",
              "risk_without_cause", "hard_command_after_warning", "cta_without_readiness"
            ]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_segment_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "root_cause_layer": {"type": "string", "enum": ["requirement_problem", "template_problem", "rule_problem", "skill_problem", "input_problem"]},
    "candidate_rule_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "scope", "suggestion"],
        "properties": {
          "action": {"type": "string", "enum": ["ADD", "MODIFY", "MERGE", "DEPRECATE", "DELETE", "REACTIVATE", "NO_CHANGE", "SEND_TO_OPSLAB"]},
          "scope": {"type": "string", "enum": ["template", "skill", "global"]},
          "suggestion": {"type": "string"}
        }
      }
    },
    "must_watch_tags": {
      "type": "array",
      "items": {"type": "string", "enum": ["quote_overuse", "premature_cta", "missing_bridge", "no_mechanism_explained"]}
    }
  }
}
